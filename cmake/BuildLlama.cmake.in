# cmake/BuildLlama.cmake.in — Build TurboQuant+ (llama.cpp fork) from local source
#
# Uses the existing turboquant_plus checkout at thetom.cpp for local inference.
# Fork: https://github.com/TheTom/turboquant_plus (6.9k ⭐)
# Runtime: https://github.com/TheTom/llama-cpp-turboquant
#
# TurboQuant+ implements Google's TurboQuant (ICLR 2026):
#   • 4.6-6.4x KV cache compression via Walsh-Hadamard polar quantization
#   • Attention-gated sparse dequantization
#   • Layer-aware V compression policies
#   • Metal kernels for Apple Silicon
#   • CUDA port with Flash Attention support
#
# Provides the `llama` target for linking into rag_native.

message(STATUS "Building TurboQuant+ from local source: /home/neo/ecosystem/thetom.cpp")

set(LLAMA_SOURCE_DIR "/home/neo/ecosystem/thetom.cpp")

if(NOT EXISTS "${LLAMA_SOURCE_DIR}/CMakeLists.txt")
    message(FATAL_ERROR "llama.cpp source not found at ${LLAMA_SOURCE_DIR}")
endif()

# llama.cpp build options (minimal — only what we need)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(LLAMA_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(LLAMA_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(LLAMA_BUILD_SERVER OFF CACHE BOOL "" FORCE)
set(LLAMA_METAL OFF CACHE BOOL "" FORCE)
set(LLAMA_CUDA OFF CACHE BOOL "" FORCE)
set(LLAMA_VULKAN OFF CACHE BOOL "" FORCE)
set(LLAMA_OPENMP ON CACHE BOOL "" FORCE)

add_subdirectory(${LLAMA_SOURCE_DIR} llama EXCLUDE_FROM_ALL)

message(STATUS "llama.cpp linked from: ${LLAMA_SOURCE_DIR}")
